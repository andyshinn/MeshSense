{
  "name": "meshsense",
  "version": "1.2.0",
  "description": "MeshSense directly connects to your Meshtastic node via Bluetooth or WiFi and continuously provides information to assess the health of your mesh network.",
  "workspaces": [
    "ui",
    "api",
    "electron"
  ],
  "scripts": {
    "dev": "pnpm --filter ui dev & DEV_UI_URL=http://localhost:5921 pnpm --filter api dev",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "build": "pnpm -r build",
    "build:mac": "pnpm -r build && pnpm --filter electron build:mac",
    "build:win": "pnpm -r build && pnpm --filter electron build:win",
    "build:linux": "pnpm -r build && pnpm --filter electron build:linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Affirmatech/MeshSense.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Affirmatech/MeshSense/issues"
  },
  "homepage": "https://github.com/Affirmatech/MeshSense",
  "devDependencies": {
    "@biomejs/biome": "^2.2.0"
  }
}
