{
  "name": "electron",
  "version": "1.2.0",
  "description": "MeshSense is a simple, open-source application that monitors, maps and graphically displays all the vital stats of your area's Meshtastic network including connected nodes, signal reports, trace routes and more!",
  "main": "./.vite/build/main.js",
  "author": "Affirmatech Inc.",
  "homepage": "https://affirmatech.com",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "start": "npm run dev -w ui & DEV_API_URL=http://localhost:5920 npm run -w api dev & DEV_API_URL=http://localhost:5920 electron-forge start",
    "dev": "DEV_API_URL=http://localhost:5920 electron-forge start",
    "build": "npm run typecheck && electron-forge package",
    "build:win": "electron-forge make --platform=win32",
    "build:mac": "electron-forge make --platform=darwin",
    "build:linux": "electron-forge make --platform=linux",
    "icon:generate": "cd build && ./create-adaptive-icon.sh",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@meshtastic/core": "^2.6.6-1",
    "@meshtastic/transport-http": "^0.2.3-2",
    "@meshtastic/transport-web-bluetooth": "^0.1.4-1",
    "@meshtastic/transport-web-serial": "^0.2.3-1",
    "electron-squirrel-startup": "^1.0.1",
    "env-paths": "^3.0.0",
    "key-file-storage": "^2.3.3",
    "webbluetooth": "^3.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-base": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron-forge/shared-types": "^7.8.3",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^1.8.0",
    "@rollup-extras/plugin-copy": "^1.11.1",
    "@types/node": "^24.3.0",
    "electron": "^37.3.0",
    "electron-updater": "^6.3.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.2"
  }
}
